# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Demo Mode Flag:
# When true: enables UI OTP hint helper for testing without an SMTP server.
# When false (production): OTP hint helper is completely hidden and disabled.
VITE_DEMO_MODE=true

# Circulation Mock Mode Flags:
# Set to true to use rich local circulation store for loans/holds/staff operations.
# Search and Work Detail remain backed by Supabase RPCs.
VITE_STAFF_MOCK=true
VITE_STUDENT_MOCK=true
